{
	"name": "ffmpeg-command-generate-webapp",
	"private": true,
	"version": "0.5.2",
	"type": "module",
	"engines": {
		"node": ">=26.13.0 <27"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint src",
		"format": "oxfmt src tests .storybook",
		"format:check": "oxfmt --check src tests .storybook",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.76.0",
		"@storybook/addon-a11y": "^10.6.7",
		"@storybook/addon-docs": "^10.6.7",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/sveltekit": "^10.6.7",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"clsx": "^2.1.1",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"sharp": "^0.35.5",
		"storybook": "^10.6.7",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^3.7.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@sveltekit-i18n/extension-stores": "^3.2.1",
		"class-variance-authority": "^0.7.1",
		"sveltekit-i18n": "^3.4.1"
	}
}
